{
  "expo": {
    "name": "iDojo",
    "slug": "iDojo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/squareicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "gradleProps": {
        "newArchEnabled": "false"
      },
      "package": "DojoSoft.ZaakirMungrue.iDojo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/squareicon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-video",
      "expo-audio",
      "expo-asset",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "38556ed3-11ef-493c-bb72-8f497678fd25"
      }
    }
  }
}
